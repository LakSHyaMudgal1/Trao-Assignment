# ========================================================
# AI Interview Prep Kit - Environment Configuration
# ========================================================

# Server Configuration
NODE_ENV=development
PORT=5000
API_PREFIX=/api

# Database
# Local MongoDB or MongoDB Atlas URI:
MONGODB_URI=mongodb://127.0.0.1:27017/ai-prep-kit

# Authentication & Security
JWT_SECRET=super-secret-key-change-this-in-production-min-32-chars
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:3000

# Retrieval & Security Settings
# In production, set to false. In batch testing/local evaluation, can be set to true to allow localhost URLs
ALLOW_LOCAL_URLS=true
CRAWL_TIMEOUT_MS=5000
MAX_CRAWL_BYTES=2097152

# LLM Provider Configuration (Google Gemini Free Tier)
# Get a free key at https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:5000
